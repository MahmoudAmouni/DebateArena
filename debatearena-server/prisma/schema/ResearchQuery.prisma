/// Free-form AI research question.
model ResearchQuery {
  id             String             @id @default(uuid())
  sessionId      String             @map("session_id")
  requestedBy    String             @map("requested_by")
  queryText      String             @map("query_text") @db.Text
  responseText   String?            @map("response_text") @db.Text
  sources        Json?
  wasDeclined    Boolean            @default(false) @map("was_declined")
  declinedReason String?            @map("declined_reason") @db.VarChar(255)
  processingMs   Int?               @map("processing_ms")
  requestedAt    DateTime           @default(now()) @map("requested_at")
  completedAt    DateTime?          @map("completed_at")

  session   Session            @relation(fields: [sessionId], references: [id])
  requester SessionParticipant @relation(fields: [requestedBy], references: [id])

  @@index([sessionId])
  @@map("research_queries")
}
